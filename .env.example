# ==============================================================================
# Talent360 - Variables d'Environnement (Production / Render & Local)
# ==============================================================================

# Profil Spring actif (utiliser 'prod' sur Render, 'dev' en local)
SPRING_PROFILES_ACTIVE=prod

# Port d'écoute (Render fournit automatiquement la variable PORT)
PORT=8080

# ------------------------------------------------------------------------------
# Base de Données MySQL (Obligatoire en Production)
# ------------------------------------------------------------------------------
# Supporte SPRING_DATASOURCE_* ou les alias DB_*
# Compatible avec Aiven MySQL, Railway MySQL, Clever Cloud, PlanetScale, TiDB Cloud, etc.
# Note : Toujours inclure ?useSSL=true ou ?sslMode=REQUIRED selon le fournisseur cloud
SPRING_DATASOURCE_URL=jdbc:mysql://<db-host>:<port>/talent360?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=votre_utilisateur_db
SPRING_DATASOURCE_PASSWORD=votre_mot_de_passe_db

# Alias alternatifs compatibles :
DB_URL=jdbc:mysql://<db-host>:<port>/talent360?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=votre_utilisateur_db
DB_PASSWORD=votre_mot_de_passe_db

# Dimensionnement du Pool Hikari (optimisé pour instances Cloud / Render)
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# ------------------------------------------------------------------------------
# Sécurité & Tokens JWT (Obligatoire)
# ------------------------------------------------------------------------------
# Clé secrète de minimum 256 bits (64 caractères hexadécimaux ou base64)
# Ex. de génération sous Linux/Mac : openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ------------------------------------------------------------------------------
# CORS (Origines Autorégées pour le Frontend)
# ------------------------------------------------------------------------------
# Séparer les URL par des virgules (SANS slash final)
# Ajouter l'URL de votre frontend Render / Vercel et vos URL locales
CORS_ALLOWED_ORIGINS=https://talent360-frontend.onrender.com,https://talent360.vercel.app,http://localhost:5173

# ------------------------------------------------------------------------------
# Intelligence Artificielle (OpenAI)
# ------------------------------------------------------------------------------
# Clé API OpenAI (si non fournie, les modules IA utiliseront des fallbacks/mock)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# Stockage des Fichiers & CVs
# ------------------------------------------------------------------------------
# Répertoire où sont enregistrés les fichiers PDF/DOCX téléversés
UPLOAD_DIR=/app/uploads/cvs
